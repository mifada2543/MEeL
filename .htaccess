# Security defaults for MEeL
Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "(\.env|\.git|\.htaccess|\.htpasswd|\.sql|\.log|config\.php|settings\.php|settings\.example\.php|cookies\.txt|auth\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ── PWA: /sw.js disajikan dari generator PHP (precache dinamis dari manifest.php) ──
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^sw\.js$ sw.js.php [L]
</IfModule>

# ── Media storage: serve file upload dari MEEL_HDD_*_UPLOAD via PHP ──
<IfModule mod_rewrite.c>
    RewriteRule ^video/upload/(.+)$ video/stream.php?f=$1 [L,QSA,B]
    RewriteRule ^music/upload/(.+)$ music/file.php?f=$1 [L,QSA,B]
    RewriteRule ^books/upload/(.+)$ books/file.php?f=$1 [L,QSA,B]
</IfModule>

# ═══════════════════════════════════════════════════════════════════════
# Clean URL Routing — tanpa ekstensi .php (query string dipertahankan)
#
# URL baru (bersih):
#   /MEeL/video/watch?id=5            → video/watch.php?id=5
#   /MEeL/music/watch?id=5            → music/watch.php?id=5
#   /MEeL/music/watch?id=5&playlist_id=3 → music/watch.php?id=5&playlist_id=3
#   /MEeL/books/read?id=3             → books/read.php?id=3
#   /MEeL/books/read-pdf?id=3         → books/read_pdf.php?id=3
#   /MEeL/admin/edit-video?id=5       → admin/edit-video.php?id=5
#   /MEeL/admin/edit-music?id=5       → admin/edit-music.php?id=5
#
# Keunggulan vs path-style (/video/watch/5): kedalaman URL tidak berubah,
# sehingga semua link relatif, form POST, dan JS tetap bekerja TANPA <base>.
#
# CATATAN LOOP-SAFE: redirect 301 lama→baru memakai %{THE_REQUEST} (string
# request asli dari browser), bukan %{REQUEST_URI} — internal rewrite ke
# file .php tidak mengubah THE_REQUEST, sehingga tidak terjadi redirect loop.
# Target rewrite RELATIF (tanpa slash depan) agar otomatis mengikuti
# subdirektori deployment (/MEeL/, /var/www/html/, dll).
# ═══════════════════════════════════════════════════════════════════════
<IfModule mod_rewrite.c>

    # ── Redirect 301: URL lama (dengan .php) → tanpa .php ──
    # Pola `\s(?:[^\s]*/)?` mengakomodasi root ATAU subdirektori.
    # video/watch.php?id=X
    RewriteCond %{THE_REQUEST} \s(?:[^\s]*/)?video/watch\.php\?id=([0-9]+)\s [NC]
    RewriteRule ^ video/watch?id=%1 [R=301,L]

    # music/watch.php?id=X&playlist_id=P
    RewriteCond %{THE_REQUEST} \s(?:[^\s]*/)?music/watch\.php\?id=([0-9]+)&playlist_id=([0-9]+)\s [NC]
    RewriteRule ^ music/watch?id=%1&playlist_id=%2 [R=301,L]
    # music/watch.php?id=X
    RewriteCond %{THE_REQUEST} \s(?:[^\s]*/)?music/watch\.php\?id=([0-9]+)\s [NC]
    RewriteRule ^ music/watch?id=%1 [R=301,L]

    # books/read.php?id=X&ch=Y (chapter manga — ch dipertahankan sebagai query)
    RewriteCond %{THE_REQUEST} \s(?:[^\s]*/)?books/read\.php\?id=([0-9]+)&ch=([^&\s]+)\s [NC]
    RewriteRule ^ books/read?id=%1&ch=%2 [R=301,L]
    # books/read.php?id=X
    RewriteCond %{THE_REQUEST} \s(?:[^\s]*/)?books/read\.php\?id=([0-9]+)\s [NC]
    RewriteRule ^ books/read?id=%1 [R=301,L]
    # books/read_pdf.php?id=X
    RewriteCond %{THE_REQUEST} \s(?:[^\s]*/)?books/read_pdf\.php\?id=([0-9]+)\s [NC]
    RewriteRule ^ books/read-pdf?id=%1 [R=301,L]

    # admin/edit-video.php?id=X
    RewriteCond %{THE_REQUEST} \s(?:[^\s]*/)?admin/edit-video\.php\?id=([0-9]+)\s [NC]
    RewriteRule ^ admin/edit-video?id=%1 [R=301,L]
    # admin/edit-music.php?id=X
    RewriteCond %{THE_REQUEST} \s(?:[^\s]*/)?admin/edit-music\.php\?id=([0-9]+)\s [NC]
    RewriteRule ^ admin/edit-music?id=%1 [R=301,L]

    # ── Redirect 301: path-style (jika pernah di-bookmark) → query-style ──
    RewriteCond %{THE_REQUEST} \s(?:[^\s]*/)?video/watch/([0-9]+)\s [NC]
    RewriteRule ^ video/watch?id=%1 [R=301,L]
    RewriteCond %{THE_REQUEST} \s(?:[^\s]*/)?music/watch/([0-9]+)/playlist/([0-9]+)\s [NC]
    RewriteRule ^ music/watch?id=%1&playlist_id=%2 [R=301,L]
    RewriteCond %{THE_REQUEST} \s(?:[^\s]*/)?music/watch/([0-9]+)\s [NC]
    RewriteRule ^ music/watch?id=%1 [R=301,L]
    RewriteCond %{THE_REQUEST} \s(?:[^\s]*/)?books/read/([0-9]+)\s [NC]
    RewriteRule ^ books/read?id=%1 [R=301,L]
    RewriteCond %{THE_REQUEST} \s(?:[^\s]*/)?books/read-pdf/([0-9]+)\s [NC]
    RewriteRule ^ books/read-pdf?id=%1 [R=301,L]
    RewriteCond %{THE_REQUEST} \s(?:[^\s]*/)?admin/edit-video/([0-9]+)\s [NC]
    RewriteRule ^ admin/edit-video?id=%1 [R=301,L]
    RewriteCond %{THE_REQUEST} \s(?:[^\s]*/)?admin/edit-music/([0-9]+)\s [NC]
    RewriteRule ^ admin/edit-music?id=%1 [R=301,L]

    # ── Internal rewrite: URL tanpa .php → file PHP asli (QSA menjaga query) ──
    RewriteRule ^video/watch/?$ video/watch.php [L,QSA]
    RewriteRule ^music/watch/?$ music/watch.php [L,QSA]
    RewriteRule ^books/read/?$ books/read.php [L,QSA]
    RewriteRule ^books/read-pdf/?$ books/read_pdf.php [L,QSA]
    RewriteRule ^admin/edit-video/?$ admin/edit-video.php [L,QSA]
    RewriteRule ^admin/edit-music/?$ admin/edit-music.php [L,QSA]
</IfModule>
