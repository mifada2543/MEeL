# Security defaults for MEeL
Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "(\.env|\.git|\.htaccess|\.htpasswd|\.sql|\.log|config\.php|settings\.php|settings\.example\.php|cookies\.txt|auth\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ── PWA: /sw.js disajikan dari generator PHP (precache dinamis dari manifest.php) ──
# sw.js.php menghitung daftar precache + SW_VERSION otomatis, jadi menambah
# folder modul CSS baru tidak perlu menyentuh service worker manual.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^sw\.js$ sw.js.php [L]
</IfModule>
