# Deny web access — partial HTML (head.html, nav.html, footer.html) boleh
# di-fetch oleh docs viewer (docs.js); file lain (PHP, dll.) diblokir.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Izinkan partial .html yang di-fetch docs viewer; blokir semua file lain
    RewriteCond %{REQUEST_URI} !\.html?$ [NC]
    RewriteCond %{REQUEST_URI} ^(.*/)[^/]+/?$
    RewriteRule ^ - [F,L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
