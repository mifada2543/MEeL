# Security defaults for controllers
# Catatan: akses langsung ke controllers/*.php kini di-301 oleh .htaccess root
# ke rute bersih (api/*, admin/actions, dll.) — rule [F] lama dihapus karena
# mengganggu redirect parent (per-dir processing). File include-only (kelas)
# yang diakses langsung akan 301 → 404 oleh router, tetap tidak terekspos.
Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
