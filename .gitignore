# ==========================================
# MEeL Media Hub - Git Ignore Configuration
# ==========================================

# ─── SENSITIVE CONFIGURATION ───────────────────────────
auth/settings.php
auth/local.config.php
.env
.env.local
.env.*.local

# ─── UPLOADED MEDIA & USER FILES ───────────────────────
music/upload
!music/upload/
music/upload/*
video/upload
!video/upload/
video/upload/*
books/upload
!books/upload/
books/upload/*
profile/upload/*
temp/*
.agents
# ─── DATA_DRIVE (Cloud Drive storage) ───────────────────
data_drive/public
!data_drive/public/
data_drive/public/*
!**/data_drive/public/.gitkeep
data_drive/private_admins
!data_drive/private_admins/
data_drive/private_admins/*
!**/data_drive/private_admins/.gitkeep
!**/data_drive/private_admins/.htaccess
!**/upload/.gitkeep
!**/upload/.htaccess
!profile/upload/default_avatar.png
!**/temp/.gitkeep
!**/temp/.htaccess

# ─── SEO (file & generator — khusus lokal/personal, tidak untuk di-commit) ───
sitemap.xml
robots.txt
sitemap.php
robots.php

# ─── CACHE & TEMPORARY FILES ──────────────────────────
.cache/
cache/
*.cache
*.tmp
transcode_temp/*
*.converting

# ─── SESSION & COOKIES ────────────────────────────────
cookies.txt
session/*
*.session

# ─── DATABASE FILES ───────────────────────────────────
/mysql/
*.sql
!migration.sql
!install.sql
!schema.sql
*.db
*.sqlite
test.php
