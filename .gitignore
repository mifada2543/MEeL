*.swp
*.swo
*~
.vim/
.nvim/

# Atom
.atom/

# Visual Studio
.vs/
*.suo
*.user

# ─── DEPENDENCY MANAGEMENT ────────────────────────────
vendor/
composer.phar

# npm (if used for frontend)
node_modules/
npm-debug.log
yarn-error.log
package-lock.json
yarn.lock

# ─── BUILD & DISTRIBUTION ─────────────────────────────
dist/
build/
out/

# ─── LOGS ─────────────────────────────────────────────
error_log
*.log
error.log
access.log
debug.log

# ─── DEVELOPMENT NOTES ────────────────────────────────
notes/
TODO.md
NOTES.md
*.local.md

# ─── TESTING ──────────────────────────────────────────
tests/coverage/
tests/*.result
.phpunit.result.cache
logs/tests/
!logs/tests/.htaccess
*.html
!index.html

# ─── DEPLOYMENT FILES ─────────────────────────────────
deploy.sh
*.deploy

# ─── BACKUP FILES ─────────────────────────────────────
*.bak
*.backup
*.orig
~*

# ─── ARCHIVES ─────────────────────────────────────────
*.zip
*.tar
*.tar.gz
*.rar
*.7z

